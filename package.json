{
  "name": "emuBro",
  "version": "1.0.0-alpha.20260317",
  "description": " emuBro is an open source retro game launcher that associates your retro games with your emulators such as snes9x, epsxe, pcsx2, dolphin, cemu or whatever you like. ",
  "scripts": {
    "postinstall": "node -e \"console.log('Root postinstall: use npm run scripts:help for the main commands.')\"",
    "scripts:help": "node -e \"console.log(['emuBro script shortcuts:','  npm run app:desktop:dev        Start the Tauri desktop app (classic UI by default).','  npm run app:web:dev            Start the Vite web shell only.','  npm run app:desktop:build      Build the desktop app bundle.','  npm run app:web:build          Build the Vite web shell bundle.','  npm run ui:legacy:build        Build the legacy renderer bundle only.','  npm run resources:sync         Sync app resources and game lists.','  npm run release:alpha          Bump alpha version, commit, push, and tag the current branch.'].join('\\n'))\"",
    "start": "npm run app:desktop:dev",
    "start:fast": "npm run app:desktop:dev",
    "cleanup:dev-ports": "node scripts/cleanup-dev-ports.js",
    "cleanup:win-shell-cache": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clear-windows-shell-cache.ps1",
    "app:desktop:dev": "npm --prefix desktop run app:desktop:dev",
    "app:desktop:dev:clean": "npm --prefix desktop run app:desktop:dev:clean",
    "app:web:dev": "npm --prefix desktop run app:web:dev",
    "dev": "npm run app:desktop:dev",
    "dev:web": "npm run app:web:dev",
    "ui:legacy:build": "webpack --config webpack.config.js",
    "ui:legacy:watch": "webpack --config webpack.config.js --watch --mode development",
    "legacy:build": "webpack --config webpack.config.js",
    "legacy:watch": "webpack --config webpack.config.js --watch --mode development",
    "i18n:sync-shell": "node scripts/sync-shell-i18n-defaults.js",
    "app:desktop:build": "npm --prefix desktop run app:desktop:build",
    "app:desktop:build:linux:appimage": "npm --prefix desktop run app:desktop:build:linux:appimage",
    "app:desktop:build:linux:flatpak": "npm --prefix desktop run app:desktop:build:linux:flatpak",
    "app:desktop:build:mac": "npm --prefix desktop run app:desktop:build:mac",
    "app:web:build": "npm --prefix desktop run app:web:build",
    "build": "npm run app:desktop:build",
    "build:win:portable": "npm run sync:bundle-resources && node scripts/build-windows-portable.js",
    "build:linux:appimage": "npm run app:desktop:build:linux:appimage",
    "build:linux:flatpak": "npm run app:desktop:build:linux:flatpak",
    "build:mac": "npm run app:desktop:build:mac",
    "build:web": "npm run app:web:build",
    "prebuild:win": "taskkill /F /IM emuBro.exe /T || exit 0",
    "version:set": "node scripts/bump-version.js",
    "version:sync": "node scripts/bump-version.js sync",
    "release:alpha": "node scripts/release-workflow.js",
    "resources:sync": "npm run sync:resources && npm run sync:gamelist",
    "roadmap:build": "node scripts/generate-roadmap-dashboard.js",
    "sync:resources": "node scripts/sync-emubro-resources.js",
    "sync:gamelist": "node scripts/sync-gamelist.js",
    "sync:assets": "npm run sync:resources && npm run sync:gamelist",
    "sync:bundle-resources": "node scripts/sync-bundle-resources.js",
    "resources:manifest:update": "node scripts/update-resources-manifest.js"
  },
  "keywords": [
    "desktop",
    "vue",
    "pinia",
    "steam",
    "gaming",
    "app"
  ],
  "author": "sysout",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babel-loader": "^10.0.0",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.4",
    "nodemon": "^3.1.11",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "axios": "^1.13.2",
    "flag-icons": "^7.5.0",
    "gamepad.js": "^2.1.0"
  }
}
